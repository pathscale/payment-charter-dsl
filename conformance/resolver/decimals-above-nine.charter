# expect: E223
# The resolver knows DAI and the language declines to bound it: eighteen
# decimals put u64 minor units at 18.44 tokens (§2.6). Refused, not truncated.
charter high-decimals version 1
resolver common@41
timezone UTC

  asset DAI_maker = mint://DAI/MakerDAO/0x6b175474e89094c44da98b954eedeac495271d0f/eip155:1

  limit monthly
    amount 500.00 DAI_maker
    per fixed month
