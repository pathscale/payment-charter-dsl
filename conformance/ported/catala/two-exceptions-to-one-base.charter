# expect: E304
# Derived from CatalaLang/catala tests/exception/bad/two_exceptions.catala_en
# Copyright (c) Inria and the Catala contributors. Apache-2.0.
# Modified: re-expressed in Payment Charter DSL.
#
# Catala warns here: two exceptions to one base with the same condition, which
# it says "will always trigger a conflict at runtime".
#
# Charter makes it a compile error. A conflict that can be seen statically must
# not be deferred to runtime, because the runtime answer is a denial in the
# middle of a payment rather than a rejection at authoring time. §8.2.2 keeps a
# runtime conflict case only for overlap a compiler could not decide.
charter two-exceptions version 1
resolver common@41
timezone UTC

  asset USDC_circle = mint://USDC/Circle/EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v/solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

  group suppliers = { 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU }

  limit x
    amount 0 USDC_circle
      except 100.00 USDC_circle when counterparty in suppliers
      except 200.00 USDC_circle when counterparty in suppliers
    per fixed day
