resolver common@41
timezone UTC+00:00

  asset USDC_circle = mint://USDC/Circle/EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v/solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

  group payroll_recipients = { 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU }

  limit monthly
    amount 100.00 USDC_circle
      except unlimited when counterparty in payroll_recipients
    per fixed month
